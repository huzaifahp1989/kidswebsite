# Copy this file to `.env` (for local dev) and set real values.
# Vite loads `.env` / `.env.local` at startup. Restart the dev server after changes.

# Supabase project configuration
VITE_SUPABASE_URL=https://jlqrbbqsuksncrxjcmbc.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

VITE_QURAN_API_TOKEN=YOUR_QURAN_API_TOKEN
VITE_QURAN_API_CLIENT_ID=YOUR_QURAN_API_CLIENT_ID

# Admin gating (recommended)
# Exact email allowed into admin pages via AdminGuard
VITE_ADMIN_EMAIL=admin@example.com

# Optional Netlify backend for messages
VITE_USE_BACKEND=false

# OneSignal Web Push (Keys & IDs in OneSignal dashboard)
VITE_ONESIGNAL_APP_ID=daf8fc36-781a-417d-8ee4-5078635f22e7

# OneSignal REST API (server-side — used by /api/onesignal admin send)
# Get from OneSignal → Settings → Keys & IDs → REST API Key
# Also set ONESIGNAL_REST_API_KEY in Vercel Project → Environment Variables
ONESIGNAL_REST_API_KEY=YOUR_ONESIGNAL_REST_API_KEY
ONESIGNAL_APP_ID=daf8fc36-781a-417d-8ee4-5078635f22e7

# Firebase Analytics / Google Analytics 4 (islam-media-stats)
VITE_FIREBASE_ANALYTICS_API_KEY=AIzaSyDIpe4_imqnRmn4hB5DadmzRGGl_AndpXc
VITE_FIREBASE_ANALYTICS_AUTH_DOMAIN=islam-media-stats.firebaseapp.com
VITE_FIREBASE_ANALYTICS_PROJECT_ID=islam-media-stats
VITE_FIREBASE_ANALYTICS_STORAGE_BUCKET=islam-media-stats.firebasestorage.app
VITE_FIREBASE_ANALYTICS_MESSAGING_SENDER_ID=748617367224
VITE_FIREBASE_ANALYTICS_APP_ID=1:748617367224:web:18469c9aa80e975860be4d
VITE_FIREBASE_ANALYTICS_MEASUREMENT_ID=G-8LHGLLY2NC

# Setup notes
# 1. In Supabase → Authentication: enable Email/Password
# 2. Add your site URL (e.g. imediackids.com) to Redirect URLs
# 3. Run supabase/schema.sql in the Supabase SQL editor to create tables
# 4. Set VITE_SUPABASE_ANON_KEY from Supabase → Project Settings → API
# 5. Analytics: view reports in Firebase Console → Analytics, or GA4 property G-8LHGLLY2NC
