{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/utils/**"
    }
  },
  "rewrites": [
    { "source": "/api/onesignal(.*)", "destination": "/api/index.js" },
    { "source": "/api/me/notices(.*)", "destination": "/api/index.js" },
    { "source": "/api/admin/notices(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
